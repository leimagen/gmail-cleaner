# Server
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key

# Database (SQLite for local, swap to postgresql+asyncpg://... for cloud)
DATABASE_URL=sqlite+aiosqlite:///./data/gmail_cleaner.db

# Google OAuth (download credentials.json from Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials/credentials.json
GOOGLE_TOKEN_DIR=credentials

# OAuth redirect URI (update for production)
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# Have I Been Pwned API (optional — get free key at haveibeenpwned.com/API/Key)
HIBP_API_KEY=

# CORS — comma-separated origins allowed (include your chrome-extension:// ID for prod)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
